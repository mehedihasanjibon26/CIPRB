        href: "https://www.ciprb.org/scientific-publications",
      },
      {
        label: "Newsletters",
        href: "https://www.ciprb.org/newsletters",
      },
      {
        label: "Case Stories",
        href: "https://www.ciprb.org/case-story",
      },
    ],
  },
  {
    label: "Our Projects",
    href: "https://www.ciprb.org/drowning-prevention",
    links: [
      {
        label: "Drowning Prevention Projects",
        href: "https://www.ciprb.org/drowning-prevention",
      },
      {
        label: "SeaSafe",
        href: "https://www.ciprb.org/seasafe",
      },
      {
        label: "CreCHes",
        href: "https://www.ciprb.org/creches",
      },
    ],
  },
  {
