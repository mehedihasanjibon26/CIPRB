];

function SearchField({
  compact = false,
}: {
  compact?: boolean;
}) {
  return (
    <form
      action="https://www.ciprb.org/search/searchData"
      method="get"
      role="search"
      className={`group relative flex items-center rounded-full border border-[#D6E6F6] bg-[#F5F9FD]/85 transition-all duration-300 focus-within:border-[#64AFF6] focus-within:bg-white focus-within:shadow-[0_0_0_4px_rgba(12,100,213,0.08)] ${
        compact ? "h-[43px] w-[165px]" : "h-12 w-full"
      }`}
    >
      <Search
        size={17}
        strokeWidth={1.9}
        className="ml-3.5 shrink-0 text-[#0C4DA2]"
      />

      <input
        type="search"
        name="title"
        aria-label="Search CIPRB website"
        placeholder="Search..."
        className="h-full w-full min-w-0 bg-transparent px-2 text-[17px] text-[#17355B] outline-none placeholder:text-[#849AB2]"
      />

      <button
        type="submit"
        aria-label="Submit search"
        className="mr-1.5 flex h-8 w-8 shrink-0 items-center justify-center rounded-full text-[#0C4DA2] transition-colors hover:bg-[#DCEEFF]"
      >
        <ArrowUpRight size={15} />
      </button>
    </form>
  );
}

function DesktopMenu({
  item,
}: {
  item: NavItem;
}) {
  return (
    <div className="group/nav relative flex h-full shrink-0 items-center">
      <div className="relative">
        {/* Water-morphism hover surface */}
        <div
          aria-hidden="true"
          className="pointer-events-none absolute -inset-x-3 -inset-y-3 overflow-hidden rounded-full border border-white/0 bg-white/0 shadow-none transition-all duration-500 ease-out group-hover/nav:border-white/95 group-hover/nav:bg-[linear-gradient(125deg,rgba(255,255,255,0.97),rgba(216,237,255,0.72),rgba(255,255,255,0.94))] group-hover/nav:shadow-[0_5px_20px_rgba(19,87,162,0.10),inset_0_1px_1px_rgba(255,255,255,1)] group-focus-within/nav:border-[#B5DFFF] group-focus-within/nav:bg-[#EDF7FF]"
        >
          <span className="absolute -top-5 left-1/3 h-10 w-14 rounded-full bg-white/80 opacity-0 blur-md transition-all duration-500 group-hover/nav:translate-x-5 group-hover/nav:opacity-100" />
          <span className="absolute -bottom-8 right-1 h-12 w-12 rounded-full bg-[#A3D9FF]/40 opacity-0 blur-lg transition-all duration-500 group-hover/nav:-translate-y-4 group-hover/nav:opacity-100" />
        </div>

        <Link
          href={item.href}
          target="_blank"
          rel="noopener noreferrer"
          className="relative z-10 inline-flex h-11 items-center gap-[6px] whitespace-nowrap text-[12px] font-semibold text-[#243A55] transition-colors duration-300 hover:text-[#0C4DA2] focus-visible:rounded-md focus-visible:outline-2 focus-visible:outline-[#0C64D5] min-[1700px]:text-[17px]"
        >
          {item.label}

          {/* Every menu uses the SAME downward chevron */}
          <ChevronDown
            size={14}
            strokeWidth={2}
            className="shrink-0 transition-transform duration-300 group-hover/nav:rotate-180"
          />
        </Link>
      </div>

      {/* Dropdown */}
      <div className="pointer-events-none absolute top-[calc(100%-9px)] left-1/2 z-50 w-[250px] -translate-x-1/2 translate-y-2 opacity-0 transition-all duration-250 ease-out group-hover/nav:pointer-events-auto group-hover/nav:translate-y-0 group-hover/nav:opacity-100 group-focus-within/nav:pointer-events-auto group-focus-within/nav:translate-y-0 group-focus-within/nav:opacity-100">
        <div className="rounded-[22px] border border-[#DCEBFA] bg-white/95 p-2 shadow-[0_18px_48px_rgba(13,55,112,0.15)] backdrop-blur-2xl">
          {item.links.map((link) => (
            <Link
              key={`${item.label}-${link.label}`}
              href={link.href}
              target="_blank"
              rel="noopener noreferrer"
              className="group/link flex items-center justify-between gap-3 rounded-[13px] px-4 py-3 text-[12px] font-medium text-[#234469] transition-all duration-200 hover:bg-[#EDF7FF] hover:text-[#0C4DA2] focus-visible:outline-2 focus-visible:outline-[#0C64D5]"
            >
              <span>{link.label}</span>

              <ArrowUpRight
                size={15}
                className="shrink-0 opacity-40 transition-all group-hover/link:translate-x-0.5 group-hover/link:-translate-y-0.5 group-hover/link:opacity-100"
              />
            </Link>
          ))}
        </div>
      </div>
    </div>
  );
}

export default function Navbar() {
  const [mobileOpen, setMobileOpen] = useState(false);

  return (
    <header className="fixed inset-x-0 top-2 z-50 px-3 sm:px-5 lg:px-7">
      <nav
        aria-label="Main navigation"
        className="relative mx-auto flex h-[82px] w-full max-w-[1900px] items-center justify-between gap-4 rounded-[26px] border border-[#CADFF2] bg-white/90 px-5 shadow-[0_14px_36px_-24px_rgba(12,77,162,0.27)] backdrop-blur-2xl sm:px-7 2xl:h-[88px] 2xl:gap-5 2xl:px-9"
      >
        {/* Brand */}
        <Link
          href="/"
          aria-label="CIPRB home"
          className="relative z-10 flex shrink-0 items-center"
        >
          <Image
            src={`${BASE_PATH}/images/ciprb-logo.png`}
            alt="CIPRB"
            width={250}
            height={78}
            priority
            unoptimized
            className="h-auto w-[160px] sm:w-[192px] 2xl:w-[205px] min-[1700px]:w-[225px]"
          />
        </Link>

        {/* Desktop navigation */}
        <div className="hidden min-w-0 flex-1 items-center justify-center gap-[15px] min-[1700px]:gap-[22px] 2xl:flex">
          {navigation.map((item) => (
            <DesktopMenu key={item.label} item={item} />
          ))}
        </div>

        {/* Desktop search + donate */}
        <div className="hidden shrink-0 items-center gap-3 2xl:flex">
          <SearchField compact />

          <Link
            href="#"
            target="_blank"
            rel="noopener noreferrer"
            className="group inline-flex h-[52px] shrink-0 items-center gap-3 rounded-full bg-[#0C4DA2] py-1.5 pr-1.5 pl-5 text-[12px] font-bold whitespace-nowrap text-white shadow-[0_10px_20px_-12px_rgba(12,77,162,0.5)] transition-all duration-300 hover:bg-[#083D84] hover:shadow-[0_14px_24px_-12px_rgba(12,77,162,0.6)]"
          >
            Donate Now

            <span className="flex h-[39px] w-[39px] items-center justify-center rounded-full bg-white text-[#0C4DA2] transition-transform duration-300 group-hover:rotate-45">
              <ArrowUpRight size={19} />
            </span>
          </Link>
        </div>

        {/* Tablet / mobile actions */}
        <div className="flex shrink-0 items-center gap-2 2xl:hidden">
          <Link
            href="#"
            target="_blank"
            rel="noopener noreferrer"
            className="hidden h-11 items-center rounded-full bg-[#0C4DA2] px-5 text-[12px] font-bold text-white sm:inline-flex"
          >
            Donate Now
          </Link>

          <button
            type="button"
            onClick={() => setMobileOpen((open) => !open)}
            aria-label={mobileOpen ? "Close menu" : "Open menu"}
            aria-expanded={mobileOpen}
            aria-controls="ciprb-mobile-menu"
            className="flex h-11 w-11 items-center justify-center rounded-full bg-[#EDF6FF] text-[#0C4DA2] transition-colors hover:bg-[#DCEEFF]"
          >
            {mobileOpen ? <X size={23} /> : <Menu size={23} />}
          </button>
        </div>
      </nav>

      {/* Tablet and mobile dropdown */}
      {mobileOpen && (
        <div
          id="ciprb-mobile-menu"
          className="mx-auto mt-2 max-h-[calc(100dvh-112px)] w-full max-w-[1900px] overflow-y-auto rounded-[24px] border border-[#D7E7F7] bg-white/97 p-5 shadow-[0_20px_60px_rgba(12,77,162,0.17)] backdrop-blur-2xl 2xl:hidden"
        >
          <SearchField />

          <div className="mt-4 divide-y divide-[#E8F0F8]">
            {navigation.map((item) => (
              <details key={item.label} className="group/details">
                <summary className="flex cursor-pointer list-none items-center justify-between gap-4 py-4 text-[17px] font-semibold text-[#1D3B61] [&::-webkit-details-marker]:hidden">
                  {item.label}

                  <ChevronDown
                    size={17}
                    className="transition-transform duration-300 group-open/details:rotate-180"
                  />
                </summary>

                <div className="mb-3 space-y-1 rounded-[15px] bg-[#F2F8FF] p-2">
                  {item.links.map((link) => (
                    <Link
                      key={link.label}
                      href={link.href}
                      target="_blank"
                      rel="noopener noreferrer"
                      onClick={() => setMobileOpen(false)}
                      className="block rounded-lg px-3 py-2.5 text-[17px] text-[#42617F] transition-colors hover:bg-white hover:text-[#0C4DA2]"
                    >
                      {link.label}
                    </Link>
                  ))}
                </div>
              </details>
            ))}
          </div>

          <Link
            href="#"
            target="_blank"
            rel="noopener noreferrer"
            className="mt-4 flex h-12 items-center justify-center rounded-full bg-[#0C4DA2] text-[17px] font-bold text-white sm:hidden"
          >
            Donate Now
          </Link>
        </div>
      )}
    </header>
  );
}
