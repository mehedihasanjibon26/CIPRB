
"use client";

import {
  useState,
  type FormEvent,
  type ReactNode,
} from "react";

import {
  ArrowUpRight,
  Clock3,
  Globe2,
  Mail,
  MapPin,
  Phone,
  UserRound,
} from "lucide-react";

const BASE_PATH = process.env.NEXT_PUBLIC_BASE_PATH ?? "";



function FacebookIcon() {
  return (
    <svg
      viewBox="0 0 24 24"
      aria-hidden="true"
      className="h-5 w-5 fill-current"
    >
      <path d="M13.5 21v-7h2.4l.4-2.8h-2.8V9.4c0-.8.2-1.4 1.4-1.4h1.5V5.5c-.3 0-1.2-.1-2.3-.1-2.3 0-3.8 1.4-3.8 4v1.8H8V14h2.2v7h3.3Z" />
    </svg>
  );
}

function XIcon() {
  return (
    <svg
      viewBox="0 0 24 24"
      aria-hidden="true"
      className="h-[17px] w-[17px] fill-current"
    >
      <path d="M18.9 3H21l-6.3 7.2L22 21h-5.7l-4.5-5.9L6.6 21H4.5l6.7-7.7L2 3h5.8l4 5.3L18.9 3Zm-2 16h1.6L7 4.9H5.3L16.9 19Z" />
    </svg>
  );
}

function YouTubeIcon() {
  return (
    <svg
      viewBox="0 0 24 24"
      aria-hidden="true"
      className="h-5 w-5 fill-current"
    >
      <path d="M23 12s0-3.1-.4-4.6c-.2-.8-.8-1.5-1.6-1.7C19.4 5.3 12 5.3 12 5.3s-7.4 0-9 .4c-.8.2-1.4.9-1.6 1.7 1.6.4 9 .4 9 .4s7.4 0 9-.4c.8-.3 1.4-.9 1.6-1.7.4-1.5.4-4.6.4-4.6ZM9.6 15.7V8.3l6.4 3.7-6.4 3.7Z" />
    </svg>
  );
}

function FooterHeading({
  children,
}: {
  children: ReactNode;
}) {
  return (
    <h3 className="mb-5 text-xs font-extrabold uppercase tracking-[0.18em] text-[#0C4DA2]">
      {children}
    </h3>
  );
}

function SocialButton({
  children,
  label,
}: {
  children: ReactNode;
  label: string;
}) {
  return (
    <button
      type="button"
      aria-label={`${label} - coming soon`}
      title={`${label} - coming soon`}
      className="flex h-11 w-11 items-center justify-center rounded-full border border-[#C3DDF0] bg-white/85 text-[#16477B] shadow-sm transition-all duration-300 hover:-translate-y-1 hover:border-[#0C4DA2] hover:bg-[#0C4DA2] hover:text-white focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#0C4DA2] motion-reduce:transform-none"
    >
      {children}
    </button>
  );
}

/*
 * Cursor-localized water particle animation.
 *
 * Particles are generated only where the mouse moves
 * over the large CIPRB logo.
 */
export default function Footer() {
  const [formMessage, setFormMessage] = useState("");

  const handleSubmit = (event: FormEvent<HTMLFormElement>) => {
    event.preventDefault();

    setFormMessage(
      "Newsletter subscriptions will be available soon."
    );
  };

  return (
    <footer
      id="footer"
      className="relative isolate overflow-hidden bg-[#F7FBFF] text-[#173956]"
    >
      {/* CIPRB scenic background */}
      <div
        aria-hidden="true"
        className="pointer-events-none absolute inset-x-0 top-0 z-0 h-[410px] overflow-hidden sm:h-[485px] lg:h-[550px]"
      >
        <div
          className="absolute inset-0 bg-cover bg-center bg-no-repeat"
          style={{
            backgroundImage: `url("${BASE_PATH}/images/footer/ciprb-footer-bg.png")`,
          }}
        />

        <div
          className="absolute inset-0"
          style={{
            background:
              "linear-gradient(180deg, rgba(247,251,255,0.02) 0%, rgba(247,251,255,0.05) 30%, rgba(247,251,255,0.72) 69%, #F7FBFF 100%)",
          }}
        />
      </div>

      {/* Compact top spacing */}
      <div
        aria-hidden="true"
        className="relative z-10 h-[75px] sm:h-[105px] lg:h-[125px]"
      />

      {/* Footer information */}
      <div className="relative z-10 mx-auto max-w-[1500px] px-6 sm:px-10 lg:px-14">
        <div className="grid grid-cols-1 gap-x-10 gap-y-10 border-t border-[#BDD9EC]/65 pt-9 md:grid-cols-2 lg:pt-10 xl:grid-cols-[1.25fr_1fr_1fr_0.7fr]">
          {/* Newsletter */}
          <div>
            <FooterHeading>Stay Connected</FooterHeading>

            <h2 className="font-serif text-[clamp(2.25rem,3.5vw,3.7rem)] leading-[1.08] tracking-[-0.05em] text-[#103C70]">
              Subscribe to
              <br />
              our updates
              <span className="text-[#1685D9]">.</span>
            </h2>

            <p className="mt-4 max-w-[350px] text-sm font-semibold leading-7 text-[#365A7A]">
              Stay informed about CIPRB&apos;s research,
              programmes and initiatives for safer communities.
            </p>

            <form
              onSubmit={handleSubmit}
              className="mt-6 max-w-[390px] space-y-3"
            >
              <label className="relative block">
                <span className="sr-only">Your name</span>

                <UserRound
                  size={18}
                  className="pointer-events-none absolute left-4 top-1/2 -translate-y-1/2 text-[#648BAB]"
                />

                <input
                  type="text"
                  name="name"
                  placeholder="Your name"
                  autoComplete="name"
                  required
                  className="h-[52px] w-full rounded-[14px] border border-[#C7DDEE] bg-white/90 pl-12 pr-4 text-sm font-semibold text-[#163653] outline-none transition-colors placeholder:text-[#7B96AC] focus:border-[#0C64D5]"
                />
              </label>

              <label className="relative block">
                <span className="sr-only">
                  Your email address
                </span>

                <Mail
                  size={18}
                  className="pointer-events-none absolute left-4 top-1/2 -translate-y-1/2 text-[#648BAB]"
                />

                <input
                  type="email"
                  name="email"
                  placeholder="Your email address"
                  autoComplete="email"
                  required
                  className="h-[52px] w-full rounded-[14px] border border-[#C7DDEE] bg-white/90 pl-12 pr-4 text-sm font-semibold text-[#163653] outline-none transition-colors placeholder:text-[#7B96AC] focus:border-[#0C64D5]"
                />
              </label>

              <button
                type="submit"
                className="group flex h-[52px] w-full items-center justify-center gap-3 rounded-[14px] bg-[#0C4DA2] text-sm font-semibold text-white shadow-lg transition-all duration-300 hover:-translate-y-0.5 hover:bg-[#0B65C7] motion-reduce:transform-none"
              >
                Subscribe

                <ArrowUpRight
                  size={18}
                  className="transition-transform duration-300 group-hover:translate-x-1 group-hover:-translate-y-1"
                />
              </button>

              {formMessage && (
                <p
                  role="status"
                  className="text-xs font-semibold leading-5 text-[#38658C]"
                >
                  {formMessage}
                </p>
              )}
            </form>
          </div>

          {/* About */}
          <div>
            <FooterHeading>About CIPRB</FooterHeading>

            <p className="max-w-[340px] text-[15px] font-semibold leading-8 text-[#365A7A]">
              The Centre for Injury Prevention and Research,
              Bangladesh (CIPRB) is a world leading injury
              prevention organisation based in Bangladesh.
            </p>

            <div className="mt-6 border-l-[3px] border-[#239BE8] pl-4">
              <p className="font-serif text-[24px] leading-[1.35] tracking-[-0.02em] text-[#114C87]">
                Building safer lives through research and prevention.
              </p>
            </div>
          </div>

          {/* Contact */}
          <div>
            <FooterHeading>Contact Us</FooterHeading>

            <div className="space-y-5 text-sm font-semibold leading-7 text-[#365A7A]">
              <div className="flex items-start gap-3">
                <MapPin
                  size={19}
                  className="mt-1 shrink-0 text-[#0C64D5]"
                />

                <span>
                  H#B120, Road#7, New DOHS,
                  <br />
                  Mohakhali, Dhaka 1207
                </span>
              </div>

              <div className="flex items-start gap-3">
                <Globe2
                  size={19}
                  className="mt-1 shrink-0 text-[#0C64D5]"
                />
                <span>www.ciprb.org</span>
              </div>

              <div className="flex items-start gap-3">
                <Mail
                  size={19}
                  className="mt-1 shrink-0 text-[#0C64D5]"
                />

                <a
                  href="mailto:info@ciprb.org"
                  className="hover:text-[#0C4DA2]"
                >
                  info@ciprb.org
                </a>
              </div>

              <div className="flex items-start gap-3">
                <Phone
                  size={19}
                  className="mt-1 shrink-0 text-[#0C64D5]"
                />

                <a
                  href="tel:+880258814988"
                  className="hover:text-[#0C4DA2]"
                >
                  +880 258814988
                </a>
              </div>

              <div className="flex items-start gap-3">
                <Clock3
                  size={19}
                  className="mt-1 shrink-0 text-[#0C64D5]"
                />

                <span>Sun - Thu: 8.30am to 5.00pm</span>
              </div>
            </div>
          </div>

          {/* Social */}
          <div>
            <FooterHeading>Follow Us</FooterHeading>

            <p className="max-w-[230px] text-sm font-semibold leading-7 text-[#365A7A]">
              Connect with CIPRB and follow our journey.
            </p>

            <div className="mt-6 flex flex-wrap gap-3">
              <SocialButton label="Facebook">
                <FacebookIcon />
              </SocialButton>

              <SocialButton label="X">
                <XIcon />
              </SocialButton>

              <SocialButton label="YouTube">
                <YouTubeIcon />
              </SocialButton>
            </div>
          </div>
        </div>

        {/* Copyright */}
        <div className="flex flex-col items-center justify-between gap-3 py-7 text-xs font-semibold text-[#466987] sm:flex-row sm:text-sm">
          <p>© 2026 CIPRB. All Rights Reserved.</p>

          <p className="text-center sm:text-right">
            Centre for Injury Prevention and Research, Bangladesh
          </p>
        </div>
      </div>
    </footer>
  );
}
